# Скопируйте в .env и заполните. .env в git не коммитим.

# 2ГИС: platform.2gis.ru → ключ для Catalog API (Places)
DGIS_API_KEY=0a38e0be-91a5-4bdb-8e2b-377c0f78e57e

# DaData: dadata.ru → Личный кабинет → API-ключ и секретный ключ
DADATA_API_KEY=
DADATA_SECRET_KEY=


# hh.ru: публичный поиск вакансий без токена, но с обязательным заголовком
# формат: ИмяПриложения/версия (реальный e-mail команды)
HH_USER_AGENT=rt-radar/0.1 (team@your-domain.ru)
# Нужны только если будем работать от имени приложения (dev.hh.ru → Мои приложения)
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# --- Вход с двумя факторами (пароль + код на почту) ---
# Ключ для HMAC кодов: длинная случайная строка, одна на все копии API (python -c "import secrets; print(secrets.token_urlsafe(32))")
AUTH_SECRET=
# Resend (resend.com, HTTPS — работает, даже если хостинг закрыл почтовые порты). Если задан — используется вместо SMTP.
# Без своего домена письма доходят только на почту владельца аккаунта Resend.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Почта для кодов. Яндекс 360 / Mail.ru: smtp.yandex.ru / smtp.mail.ru, порт 465, пароль приложения (не от ящика)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Вход гостем без пароля (жюри, показ): по умолчанию включён, 0 — выключить
AUTH_GUEST=1
# Саморегистрация с подтверждением почты: 0 — выключить; домены через запятую — только с них (пусто — любые)
AUTH_SIGNUP=1
AUTH_SIGNUP_DOMAINS=
# Только для разработки: без SMTP код пишется в журнал API. В локальном docker-compose уже включено.
# AUTH_DEV_MODE=1

# --- Вариант 2: start.bat (сайт и API на этом компьютере, база на VPS) ---
# Роль только для чтения (демо-стенд хакатона)
DATABASE_URL=postgresql+psycopg://rt_reader:da7b8e232676c10150c509bc95d0054c1e45ba59ba65220b@193.233.247.129:15432/rt

# --- Вариант 1: Docker на VPS (эти строки живут в /opt/rt/.env на сервере, создаются deploy/vps_setup.sh) ---
